<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_rounded"
    android:padding="20dp" android:layout_margin="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Game Space Menu" android:textColor="#00FFAA" android:textStyle="bold" />
    <Switch android:id="@+id/swMonitor" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Tampilkan CPU/RAM" android:textColor="#FFF" android:layout_marginTop="8dp" />
    <Switch android:id="@+id/swCrosshair" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Aktifkan Crosshair" android:textColor="#FFF" android:layout_marginTop="8dp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Ubah DPI (Butuh ADB):" android:textColor="#FFF" android:layout_marginTop="12dp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
        <Button android:id="@+id/btnDpiLow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dpi 400" android:textSize="10sp" />
        <Button android:id="@+id/btnDpiNormal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reset Dpi" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
